{
  "name": "fabricjs-design-tool",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "v2.0.0 monorepo for @rifrocket/fdt-* — a Fabric.js design-tool engine, React adapter, theme, and plugins.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rifrocket/fabricjs-design-tool.git"
  },
  "bugs": {
    "url": "https://github.com/rifrocket/fabricjs-design-tool/issues"
  },
  "homepage": "https://github.com/rifrocket/fabricjs-design-tool#readme",
  "scripts": {
    "packages:build": "turbo run build --filter=./packages/*",
    "packages:test": "turbo run test --filter=./packages/*",
    "packages:lint": "turbo run lint --filter=./packages/*",
    "packages:typecheck": "turbo run typecheck --filter=./packages/*",
    "packages:dev": "turbo run dev --filter=./packages/*",
    "packages:depcruise": "depcruise packages/core/src --config .dependency-cruiser.cjs",
    "apps:build": "turbo run build --filter=./apps/* --filter=!@rifrocket/fdt-docs",
    "apps:typecheck": "turbo run typecheck --filter=./apps/* --filter=!@rifrocket/fdt-docs",
    "apps:lint": "turbo run lint --filter=./apps/* --filter=!@rifrocket/fdt-docs",
    "apps:dev": "turbo run dev --filter=./apps/* --filter=!@rifrocket/fdt-docs",
    "docs:dev": "turbo run dev --filter=@rifrocket/fdt-docs",
    "docs:build": "turbo run build --filter=@rifrocket/fdt-docs",
    "docs:typecheck": "turbo run typecheck --filter=@rifrocket/fdt-docs",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.11",
    "@eslint/js": "^9.25.0",
    "dependency-cruiser": "^16.10.0",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "turbo": "^2.3.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1"
  },
  "packageManager": "pnpm@10.33.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
