{
  "name": "@rifrocket/fabricjs-design-tool",
  "version": "3.0.2",
  "private": false,
  "description": "Framework-agnostic canvas engine core for the FabricJS Design Tool v2.",
  "repository": {
    "type": "git",
    "url": "https://github.com/rifrocket/fabricjs-design-tool.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/rifrocket/fabricjs-design-tool/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/rifrocket/fabricjs-design-tool/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./history": {
      "types": "./dist/history.d.ts",
      "import": "./dist/history.js",
      "require": "./dist/history.cjs"
    },
    "./effects": {
      "types": "./dist/effects.d.ts",
      "import": "./dist/effects.js",
      "require": "./dist/effects.cjs"
    },
    "./export": {
      "types": "./dist/export.d.ts",
      "import": "./dist/export.js",
      "require": "./dist/export.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "fabric": "^6.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/node": "^24.0.3",
    "eslint": "^9.25.0",
    "fabric": "^6.6.7",
    "globals": "^16.0.0",
    "tsup": "^8.3.5",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vitest": "^2.1.8"
  }
}
