{
  "name": "@rifrocket/fdt-plugin-effects",
  "version": "3.0.0",
  "private": false,
  "description": "Object effects system (shadow, glow, blur, glitch, duotone, ...) for the FabricJS Design Tool v2, registered via the core plugin system.",
  "repository": {
    "type": "git",
    "url": "https://github.com/rifrocket/fabricjs-design-tool.git",
    "directory": "packages/plugin-effects"
  },
  "homepage": "https://github.com/rifrocket/fabricjs-design-tool/tree/main/packages/plugin-effects#readme",
  "bugs": {
    "url": "https://github.com/rifrocket/fabricjs-design-tool/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@rifrocket/fabricjs-design-tool": "workspace:*"
  },
  "peerDependencies": {
    "fabric": "^6.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/node": "^24.0.3",
    "eslint": "^9.25.0",
    "fabric": "^6.6.7",
    "globals": "^16.0.0",
    "tsup": "^8.3.5",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vitest": "^2.1.8"
  }
}
