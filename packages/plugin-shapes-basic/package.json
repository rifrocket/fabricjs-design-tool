{
  "name": "@rifrocket/fdt-plugin-shapes-basic",
  "version": "3.0.0",
  "private": false,
  "description": "Default shape object types (text, rect, circle, line, ellipse, polygons) for the FabricJS Design Tool v2, registered via the core plugin system.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@rifrocket/fabricjs-design-tool": "workspace:*",
    "@rifrocket/fdt-properties": "workspace:*"
  },
  "peerDependencies": {
    "fabric": "^6.6.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/node": "^24.0.3",
    "eslint": "^9.25.0",
    "fabric": "^6.6.7",
    "globals": "^16.0.0",
    "tsup": "^8.3.5",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vitest": "^2.1.8"
  }
}
